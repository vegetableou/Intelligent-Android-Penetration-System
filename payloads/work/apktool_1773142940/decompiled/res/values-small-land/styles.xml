<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Calculator" parent="@style/Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:textColorHighlight">?colorPrimaryContainer</item>
        <item name="android:colorControlActivated">?colorPrimary</item>
        <item name="android:statusBarColor">?colorSurfaceVariant</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Button" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">0.0dip</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:layout_marginBottom">@dimen/_1sdp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_marginStart">@dimen/_1sdp</item>
        <item name="android:layout_marginEnd">@dimen/_1sdp</item>
    </style>
    <style name="Button.Equals" parent="@style/Button">
        <item name="android:textSize">44.0sp</item>
        <item name="android:background">@drawable/background_button_equals</item>
        <item name="android:text">@string/equals_button</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1.0sp</item>
        <item name="android:autoSizeMinTextSize">1.0sp</item>
        <item name="android:autoSizeMaxTextSize">44.0sp</item>
    </style>
    <style name="Button.Number" parent="@style/Button">
        <item name="android:textSize">26.0sp</item>
        <item name="android:background">@drawable/background_button_number</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1.0sp</item>
        <item name="android:autoSizeMinTextSize">1.0sp</item>
        <item name="android:autoSizeMaxTextSize">26.0sp</item>
    </style>
    <style name="Button.Operator" parent="@style/Button">
        <item name="android:textSize">36.0sp</item>
        <item name="android:background">@drawable/background_button_operator</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1.0sp</item>
        <item name="android:autoSizeMinTextSize">1.0sp</item>
        <item name="android:autoSizeMaxTextSize">36.0sp</item>
    </style>
    <style name="Button.ScientificFunction" parent="@style/Button">
        <item name="android:textSize">20.0sp</item>
        <item name="android:background">@drawable/background_extra_button</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1.0sp</item>
        <item name="android:autoSizeMinTextSize">1.0sp</item>
        <item name="android:autoSizeMaxTextSize">20.0sp</item>
    </style>
    <style name="DateText" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textSize">16.0sp</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12.0dip</item>
    </style>
    <style name="Expression" parent="@style/Widget.AppCompat.EditText">
        <item name="android:textSize">52.0sp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:gravity">bottom|center|right</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">0.0dip</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
        <item name="android:layout_marginBottom">@dimen/_4sdp</item>
        <item name="android:inputType">textMultiLine|textNoSuggestions</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:layout_marginStart">12.0dip</item>
        <item name="android:layout_marginEnd">12.0dip</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">28.0sp</item>
        <item name="android:autoSizeMaxTextSize">52.0sp</item>
        <item name="autoSizeStepGranularity">1.0sp</item>
    </style>
    <style name="Expression.Result" parent="@style/Expression">
        <item name="android:textSize">38.0sp</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">0.0dip</item>
        <item name="android:layout_marginBottom">@dimen/_4sdp</item>
        <item name="android:maxLines">1</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:inputType">none</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8.0sp</item>
        <item name="android:autoSizeMaxTextSize">38.0sp</item>
        <item name="autoSizeStepGranularity">1.0sp</item>
    </style>
    <style name="ExpressionText" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textSize">20.0sp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12.0dip</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:layout_marginStart">12.0dip</item>
        <item name="android:layout_marginEnd">12.0dip</item>
    </style>
    <style name="ExpressionText.ResultText" parent="@style/ExpressionText">
        <item name="android:textSize">23.0sp</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">0.0dip</item>
        <item name="android:layout_marginBottom">12.0dip</item>
    </style>
    <style name="RecyclerViewHistory">
        <item name="android:scrollbars">vertical</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:verticalScrollbarPosition">right</item>
    </style>
    <style name="TextViewNoHistory" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textSize">19.0sp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/empty_history</item>
    </style>
    <style name="UnitRecyclerView">
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">0.0dip</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
    </style>
    <style name="UnitText" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textSize">18.0sp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6.0dip</item>
        <item name="android:layout_marginStart">12.0dip</item>
        <item name="android:layout_marginEnd">12.0dip</item>
    </style>
    <style name="UnitText.ResultText" parent="@style/UnitText">
        <item name="android:textSize">21.0sp</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:layout_marginTop">0.0dip</item>
        <item name="android:layout_marginBottom">6.0dip</item>
    </style>
    <style name="UnitTextInputLayout" parent="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
        <item name="boxStrokeWidth">0.0dip</item>
    </style>
    <style name="UnitTextInputLayout.Left" parent="@style/UnitTextInputLayout">
        <item name="android:layout_marginStart">12.0dip</item>
        <item name="android:layout_marginEnd">6.0dip</item>
    </style>
    <style name="UnitTextInputLayout.Right" parent="@style/UnitTextInputLayout">
        <item name="android:layout_marginStart">6.0dip</item>
        <item name="android:layout_marginEnd">12.0dip</item>
    </style>
    <style name="dynamicColors" parent="@style/Base.Theme.Calculator">
        <item name="colorOnPrimary">@color/material_dynamic_primary100</item>
        <item name="colorOnPrimaryContainer">@color/material_dynamic_primary10</item>
        <item name="colorOnSecondary">@color/material_dynamic_secondary100</item>
        <item name="colorOnSecondaryContainer">@color/material_dynamic_secondary10</item>
        <item name="colorOnSurface">@color/material_dynamic_neutral10</item>
        <item name="colorOnSurfaceInverse">@color/material_dynamic_neutral90</item>
        <item name="colorOnSurfaceVariant">@color/material_dynamic_neutral_variant30</item>
        <item name="colorOnTertiary">@color/material_dynamic_tertiary100</item>
        <item name="colorOnTertiaryContainer">@color/material_dynamic_tertiary10</item>
        <item name="colorOutline">@color/material_dynamic_neutral_variant50</item>
        <item name="colorPrimary">@color/material_dynamic_primary40</item>
        <item name="colorPrimaryContainer">@color/material_dynamic_primary80</item>
        <item name="colorPrimaryInverse">@color/material_dynamic_primary90</item>
        <item name="colorSecondary">@color/material_dynamic_secondary40</item>
        <item name="colorSecondaryContainer">@color/material_dynamic_secondary90</item>
        <item name="colorSurface">@color/material_dynamic_neutral99</item>
        <item name="colorSurfaceInverse">@color/material_dynamic_neutral20</item>
        <item name="colorSurfaceVariant">@color/material_dynamic_neutral_variant95</item>
        <item name="colorTertiary">@color/material_dynamic_tertiary40</item>
        <item name="colorTertiaryContainer">@color/material_dynamic_tertiary90</item>
    </style>
</resources>
